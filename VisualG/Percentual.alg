algoritmo "Percentual"
// Função :
// Autor :
// Data : 11/03/2026
// Seção de Declarações
var
   s, ns, p: real
inicio
      escreva ("digite o seu salário: ")
      leia (s)
      escreva ("digite o percentual: ")
      leia (p)
      ns <- s+(s*p)/100
      escreva ("O novo salário com ajuste é: ", ns)
fimalgoritmo
