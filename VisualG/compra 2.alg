algoritmo "Compra"
// Função :
// Autor :
// Data : 04/03/2026
// Seção de Declarações
var
   T, QC, PU: real
   P: Caracter
inicio
escreva ("Digite o nome do produto: ")
leia(P)
escreva ("Digite a quantidade comprada: ")
leia(QC)
Escreva("Digite o preço unitário do produto: ")
Leia(PU)
T <- QC * PU
Escreva("o preço total da compra foi de: ",  T , ", de ", P)
fimalgoritmo
