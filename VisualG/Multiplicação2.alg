algoritmo "multiplicação2"
// Função :
// Autor :
// Data : 04/03/2026
// Seção de Declarações
var
   numero1,numero2,dobro,triplo: inteiro
inicio
escreva ("Digite o primeiro número: ")
leia(numero1)
Escreva("Digite o segundo número: ")
Leia(numero2)
dobro <- numero1 * 2
Escreval("O resultado do dobro é: ",  dobro)
triplo <- numero2 * 3
Escreval("O resultado do triplo é: ",  triplo)
fimalgoritmo
