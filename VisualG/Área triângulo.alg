algoritmo "Triângulo"
// Função :
// Autor :
// Data : 11/03/2026
// Seção de Declarações
var
   ar, a, b : Real
inicio
      escreva ("digite o lado A do Triângulo: ")
      leia (a)
      escreva ("digite o lado B do Triângulo: ")
      leia (b)
      ar <- (a*b)/2
      escreva ("A área do Triângulo é: ", ar)
fimalgoritmo
