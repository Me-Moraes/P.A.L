algoritmo "IMC"
// Função :
// Autor :
// Data : 11/03/2026
// Seção de Declarações
var
   pe, ar, a, b : Real
inicio
      escreva ("digite o lado A do retangulo: ")
      leia (a)
      escreva ("digite o lado B do retangulo: ")
      leia (b)
      ar <- a*b
      pe <- a*2 + b*2
      escreva ("A área do retangulo é: ", ar ," e o perimetro é", pe)
fimalgoritmo
