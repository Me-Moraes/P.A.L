algoritmo "Dia vividos"
// Função :
// Autor :
// Data : 11/03/2026
// Seção de Declarações
var
   nome: caracter
   idade, diasvividos: inteiro
inicio
      escreva ("digite o seu nome: ")
      leia (nome)
      escreva ("digite a sua idade: ")
      leia (idade)
      diasvividos <- idade*365
      escreva (nome, " viveu: ", diasvividos)
fimalgoritmo
