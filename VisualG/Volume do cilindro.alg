algoritmo "Volume de um cilindro"
// Função :
// Autor :
// Data : 11/03/2026
// Seção de Declarações
var
   r, a, cir : Real
inicio
      escreva ("digite o raio do cilindro: ")
      leia (r)
      escreva ("digite a altura do cilindro: ")
      leia (a)
      cir <- (3.14159 *(r*2)* a)
      escreva ("O volume do cilindro é: ", cir)
fimalgoritmo
