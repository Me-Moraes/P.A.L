algoritmo "Idade"
// Função :
// Autor :
// Data : 11/03/2026
// Seção de Declarações
var
   I, AA, AN: inteiro
   NM: caracter
inicio
      escreva ("digite o seu nome: ")
      leia (NM)
      escreva ("digite o ano atual: ")
      leia (AA)
      escreva ("digite o seu ano de nascimento: ")
      leia (AN)
      I <- AA - AN
      escreva (NM, " tem", I, " anos")
fimalgoritmo
