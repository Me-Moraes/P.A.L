algoritmo "subtração"
// Função :
// Autor :
// Data : 04/03/2026
// Seção de Declarações
var
   sub,numero1,numero2: inteiro
inicio
escreva ("Digite o primeiro número: ")
leia(numero1)
Escreva("Digite o segundo número: ")
Leia(numero2)
sub <- numero1 - numero2
Escreva("O resultado da subtração é: ",  sub)
fimalgoritmo
