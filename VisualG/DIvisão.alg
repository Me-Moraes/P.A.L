algoritmo "Divisão"
// Função :
// Autor :
// Data : 04/03/2026
// Seção de Declarações
var
   divi,numero1,numero2: real
inicio
escreva ("Digite o primeiro número: ")
leia(numero1)
Escreva("Digite o segundo número: ")
Leia(numero2)
divi <- numero1 / numero2
Escreva("O resultado da divião é: ",  divi)
fimalgoritmo
